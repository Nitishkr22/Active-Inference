{
  "dataset_path": "../../dataset/train_dataset_v7.npz",
  "val_fraction": 0.1,
  "batch_size": 32,
  "num_workers": 4,
  "pin_memory": true,
  "shuffle_train": true,
  "persistent_workers": true,
  "prefetch_factor": 2,
  "lr": 0.001,
  "weight_decay": 1e-05,
  "num_epochs": 30,
  "grad_clip_norm": 1.0,
  "rollout_start_t_min": 4,
  "rollout_horizon": 5,
  "w_recon": 1.0,
  "w_pose": 1.2,
  "w_roll_latent": 1.0,
  "w_roll_pose": 1.5,
  "w_roll_recon": 1.0,
  "w_collision": 0.5,
  "w_roll_collision": 0.75,
  "w_roll_collision_stay": 0.5,
  "print_every": 50,
  "save_dir": "./checkpoints_v2",
  "save_every_epoch": false,
  "use_amp": true,
  "use_channels_last": false,
  "deterministic": false,
  "seed": 42
}