{
  "dataset_path": "../../dataset/train_dataset_v7.npz",
  "val_fraction": 0.1,
  "batch_size": 32,
  "num_workers": 4,
  "pin_memory": true,
  "shuffle_train": true,
  "persistent_workers": true,
  "prefetch_factor": 2,
  "drop_last_train": false,
  "drop_last_val": false,
  "lr": 0.0005,
  "weight_decay": 1e-05,
  "num_epochs": 40,
  "grad_clip_norm": 1.0,
  "rollout_start_t_min": 4,
  "rollout_horizon": 5,
  "w_recon": 0.5,
  "w_pose": 2.0,
  "w_collision": 0.3,
  "w_roll_pose": 1.0,
  "w_roll_recon": 0.5,
  "w_roll_collision": 0.5,
  "w_roll_stay": 0.5,
  "w_context_stability": 0.1,
  "w_kl_context": 0.01,
  "w_vfe_kl": 0.02,
  "kl_warmup_epochs": 5,
  "obs_noise_sigma_max": 0.2,
  "obs_mask_fraction": 0.2,
  "w_logvar_coupling": 0.05,
  "use_predictive_prior": true,
  "use_curriculum": true,
  "print_every": 50,
  "save_dir": "./checkpoints/CL1-DW",
  "save_every_epoch": false,
  "use_amp": true,
  "deterministic": false,
  "seed": 42
}